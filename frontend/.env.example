# Base URL of the deployed backend (Part 2). Used by src/config.js.
VITE_BACKEND_URL=https://your-backend.onrender.com

# Google Analytics 4 Measurement ID (see https://analytics.google.com).
# Optional — if left empty, GA4 simply isn't loaded. Used by src/analytics.js.
VITE_GA_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID (see https://tagmanager.google.com).
# Optional — if left empty, GTM simply isn't loaded. Used by src/analytics.js.
VITE_GTM_ID=GTM-XXXXXXX
